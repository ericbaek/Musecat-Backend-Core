# Runtime mode and persistent PocketBase data directory.
APP_ENV=development
PB_DATA_DIR=./pb_data

# Optional override for the vendored offline country/timezone boundaries.
# Leave empty to use the GeoJSON files embedded in the application binary.
MUSECAT_GEO_DATA_DIR=

# Set these only when using the corresponding geocoding provider.
GOOGLE_MAPS_API_KEY=
KAKAO_REST_API_KEY=

# Optional delayed community-post translation. The worker stays idle when the
# API key is empty. Keep translated variants private until quality review is complete.
OPENAI_API_KEY=
MUSECAT_TRANSLATION_MODEL=gpt-6-luna
MUSECAT_TRANSLATION_BASE_URL=https://api.openai.com/v1
MUSECAT_TRANSLATION_REASONING_EFFORT=none
MUSECAT_TRANSLATION_GLOSSARY=
MUSECAT_COMMUNITY_TRANSLATIONS_PUBLIC=false

# Optional protection for the bundled OpenAPI documentation routes.
DOCS_BASIC_AUTH_USER=
DOCS_BASIC_AUTH_PASS=

# Optional static delegated OAuth/OIDC clients. Empty config disables grants.
MUSECAT_OAUTH_ISSUER=
MUSECAT_OAUTH_CONSENT_URL=
MUSECAT_OAUTH_CLIENTS=
# JSON array of base64 PKCS8 DER RSA signing keys, newest first, at least2048 bits.
# Keep stable in the secret store; never commit real keys.
MUSECAT_OIDC_SIGNING_KEYS=

# Optional configured reverse providers and reciprocal partners.
MUSECAT_EXTERNAL_PROVIDERS=
MUSECAT_JOINT_PARTNERS=
# Stable base64 of exactly32 random bytes; protect separately from DB backups.
MUSECAT_CONNECTION_ENCRYPTION_KEY=

# Public HTTPS WebCore origin for Developer Center credentials/callbacks.
MUSECAT_WEB_ORIGIN=
